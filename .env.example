# Resend (https://resend.com). The sending domain must be verified.
RESEND_API_KEY=
RESEND_FROM="Alan Ritchson Fan Club <hello@alanritchsonfanclub.com>"
# Where website messages are delivered (defaults to hello@alanritchsonfanclub.com)
CONTACT_TO=hello@alanritchsonfanclub.com

# MongoDB (Atlas connection string)
MONGODB_URI=
MONGODB_DB=fanclub

# Admin panel: /admin
ADMIN_EMAIL=
# Generate with: npm run admin:hash -- "your password"
ADMIN_PASSWORD_HASH=
# 32+ random characters, e.g. openssl rand -base64 48
SESSION_SECRET=

# Public site URL, used for the post-payment redirect (defaults to the production domain)
SITE_URL=

# BTCPay Server (Greenfield API). API key needs: btcpay.store.cancreateinvoice + btcpay.store.canviewinvoices
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
# Any long random string; enter the same value on the store's webhook
BTCPAY_WEBHOOK_SECRET=
